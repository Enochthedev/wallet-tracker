# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/wallet_tracker

# AI Configuration (Optional - for AI-powered analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ENABLE_AI_ANALYSIS=true
AI_ANALYSIS_INTERVAL=300000

# Blockchain Explorer API Keys
# Ethereum
ETHERSCAN_API_KEY=your_etherscan_api_key

# Polygon
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# Binance Smart Chain
BSCSCAN_API_KEY=your_bscscan_api_key

# Arbitrum
ARBISCAN_API_KEY=your_arbiscan_api_key

# Optimism
OPTIMISM_API_KEY=your_optimism_api_key

# Avalanche
SNOWTRACE_API_KEY=your_snowtrace_api_key

# Solana
SOLSCAN_API_KEY=your_solscan_api_key

# Bitcoin
BLOCKCHAIN_INFO_API_KEY=your_blockchain_info_api_key

# RPC Endpoints (Optional - defaults are provided)
ETHEREUM_RPC=https://eth.llamarpc.com
POLYGON_RPC=https://polygon-rpc.com
BSC_RPC=https://bsc-dataseed.binance.org
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC=https://mainnet.optimism.io
AVALANCHE_RPC=https://api.avax.network/ext/bc/C/rpc
SOLANA_RPC=https://api.mainnet-beta.solana.com